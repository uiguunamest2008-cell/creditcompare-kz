label{display:block;font-size:13px;font-weight:700;color:#43536b;margin:13px 0 6px}input,select,textarea{width:100%;padding:12px 13px;border:1px solid #d9e1ed;border-radius:10px;font:inherit;background:white;color:var(--ink)}input:focus,select:focus,textarea:focus{outline:2px solid #bfdbfe;border-color:var(--blue)}.calc-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}.result{background:var(--sky);border-radius:15px;padding:17px;margin-top:17px}.result strong{font-size:25px;color:var(--navy);display:block}.small{font-size:12px;color:var(--muted)}.table-wrap{overflow:auto;border:1px solid var(--line);border-radius:16px;background:white}table{border-collapse:collapse;width:100%;min-width:540px}th,td{text-align:left;padding:14px 16px;border-bottom:1px solid var(--line)}th{background:#f0f5ff;color:var(--navy);font-size:13px}td{font-size:14px}tr:last-child td{border-bottom:0}.chart{display:flex;align-items:end;gap:20px;height:220px;padding:20px 12px 0;border-bottom:1px solid var(--line)}.bar-col{flex:1;text-align:center;display:flex;flex-direction:column;justify-content:end;align-items:center;height:100%;gap:8px}.bar{width:min(54px,75%);background:linear-gradient(180deg,#60a5fa,#2563eb);border-radius:9px 9px 2px 2px;min-height:8px}.bar-col b{font-size:12px;color:var(--navy)}.bar-col span{font-size:12px;color:var(--muted)}.form-note{font-size:12px;color:var(--muted)}footer{background:#0d2343;color:#dbeafe;padding:30px 0}footer p{margin:5px 0;color:#b9cbe6;font-size:13px}.notice{background:#fff8e7;border:1px solid #f5df9c;color:#76530a;border-radius:12px;padding:13px 15px;font-size:13px;margin-top:18px}
@media(max-width:760px){.nav{align-items:flex-start;flex-direction:column}nav{gap:11px}.hero{padding:54px 0}.hero-grid,.split{grid-template-columns:1fr}.cards{grid-template-columns:1fr}.section{padding:48px 0}.calc-grid{grid-template-columns:1fr}.visual{max-width:460px}}
